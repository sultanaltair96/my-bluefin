# Curated portable GNOME settings from the source installation.
# Hardware identifiers, recent paths, locations, wallpaper paths, and other
# personal data are deliberately excluded.

[Ptyxis/Shortcuts]
close-window='<Control>q'
copy-clipboard='<Control>c'
new-window='<Control>n'
paste-clipboard='<Control>v'
search='<Control>f'
select-all='<Control>a'

[desktop/interface]
accent-color='slate'
color-scheme='prefer-dark'
show-battery-percentage=true

[desktop/peripherals/mouse]
speed=1.0

[desktop/session]
idle-delay=uint32 0

[desktop/wm/keybindings]
close=['<Control>q']

[nautilus/preferences]
default-folder-viewer='list-view'

[settings-daemon/plugins/media-keys]
www=['<Super>z']

[settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'

[shell/extensions/Logo-menu]
hide-forcequit=true
hide-icon-shadow=true
menu-button-extensions-app='com.mattjakeman.ExtensionManager.desktop'
menu-button-icon-image=1
menu-button-icon-size=20
menu-button-software-center='/usr/bin/flatpak run io.github.kolunmi.Bazaar'
menu-button-system-monitor='/usr/bin/missioncenter-helper'
menu-button-terminal='xdg-terminal-exec'
show-activities-button=false
show-distroshelf=true
show-gamemode=false
show-lockscreen=false
show-power-option=false
show-power-options=false
symbolic-icon=true
use-custom-icon=false

[shell/extensions/blur-my-shell]
settings-version=2

[shell/extensions/blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[shell/extensions/blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
sigma=30

[shell/extensions/blur-my-shell/popup]
blur=false

[shell/extensions/caffeine]
cli-toggle=false
enable-mpris=true
indicator-position-max=1
user-enabled=true

[shell/extensions/resource-monitor]
cpustatus=true
displaymode='primary'
netethstatus=true
netwlanstatus=false
ramstatus=true

[shell/extensions/search-light]
background-color=(0.0, 0.0, 0.0, 0.80000000000000004)
border-color=(0.23000000000000001, 0.23000000000000001, 0.23000000000000001, 1.0)
border-radius=1.6499999999999999
border-thickness=1
scale-height=0.14999999999999999
scale-width=0.10000000000000001
shortcut-search=['<Super>space']

[shell/keybindings]
screenshot=['<Shift><Control>a']
show-screenshot-ui=['<Shift><Control>s']
